{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criterionChecks"
  ],
  "properties": {
    "criterionChecks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionKey",
          "status",
          "evidenceRefs",
          "missing"
        ],
        "properties": {
          "criterionKey": {
            "enum": [
              "criterion_qa076_identity",
              "criterion_qa076_newest",
              "criterion_qa076_protection",
              "criterion_qa076_age",
              "criterion_qa076_uncertainty",
              "criterion_qa076_accounting",
              "criterion_qa076_regressions",
              "criterion_qa076_support"
            ]
          },
          "status": {
            "enum": [
              "satisfied",
              "unresolved"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "retention-policy",
                "snapshot-inventory",
                "verification-observations",
                "active-pins"
              ]
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
