{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA-072 experiment read receipt (not a production wire type)",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "experimentId": {
      "type": "string",
      "minLength": 1
    },
    "authorityId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "roomId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceContentSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "contentSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestedRange": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "returnedRange": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "returnedBytes": {
      "type": "integer",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "returned",
        "denied",
        "failed"
      ]
    },
    "failureReason": {
      "enum": [
        null,
        "authorization_mismatch",
        "read_limit",
        "invalid_selector",
        "source_pin_mismatch",
        "source_digest_mismatch",
        "range_outside_grant",
        "source_range_unavailable",
        "invalid_utf8_boundary",
        "return_limit_too_small"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "experimentId",
    "authorityId",
    "taskId",
    "roomId",
    "runId",
    "evidenceRef",
    "revision",
    "sourceContentSha256",
    "contentSha256",
    "requestedRange",
    "returnedRange",
    "returnedBytes",
    "truncated",
    "status",
    "failureReason",
    "observedAt"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "returned"
          }
        }
      },
      "then": {
        "properties": {
          "evidenceRef": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "contentSha256": {
            "type": "string"
          },
          "requestedRange": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "returnedRange": {
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "returnedBytes": {
            "minimum": 1,
            "type": "integer"
          },
          "failureReason": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "contentSha256": {
            "type": "null"
          },
          "returnedRange": {
            "type": "null"
          },
          "returnedBytes": {
            "const": 0
          },
          "truncated": {
            "const": false
          },
          "failureReason": {
            "type": "string"
          }
        }
      }
    }
  ]
}
