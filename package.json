{
  "name": "convene-wire-network",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Lightweight Team collaboration for existing AI coding runtimes",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:site": "node site/build.mjs",
    "db:migrate": "npm run db:migrate --workspace @convene-wire/server --",
    "dev:server": "npm run dev --workspace @convene-wire/server",
    "dev:web": "npm run dev --workspace @convene-wire/web",
    "test": "npm run test:all",
    "test:all": "node scripts/test/run-with-temp-root.mjs -- npm run test:all:inner",
    "test:all:inner": "npm run test --workspaces --if-present && npm run test:bridge-ui && npm run test:qa-evidence && npm run test:product-experience && npm run test:site && npm run test:temp-lifecycle && npm run test:discussion-benchmark",
    "test:bridge": "node scripts/test/run-with-temp-root.mjs --cwd bridge -- go test ./...",
    "test:bridge-ui": "node scripts/test/run-with-temp-root.mjs -- npm run test:bridge-ui:inner",
    "test:bridge-ui:inner": "node --test bridge/internal/console/*.test.mjs",
    "test:qa-evidence": "node scripts/test/run-with-temp-root.mjs -- npm run test:qa-evidence:inner",
    "test:qa-evidence:inner": "node --test scripts/qa/*.test.mjs",
    "test:product-experience": "node scripts/test/run-with-temp-root.mjs -- tsx --test scripts/qa/product-experience-seed.test.ts",
    "test:temp-lifecycle": "node scripts/test/run-with-temp-root.mjs -- npm run test:temp-lifecycle:inner",
    "test:temp-lifecycle:inner": "node --test scripts/test/*.test.mjs",
    "preview:product-experience": "node scripts/test/run-with-temp-root.mjs -- tsx scripts/qa/product-experience-preview.mts",
    "test:site": "node scripts/test/run-with-temp-root.mjs -- npm run test:site:inner",
    "test:site:inner": "node --test site/test/*.test.mjs",
    "preview:site": "npm run build:site && node site/preview.mjs",
    "capture:qa-002": "node scripts/qa/capture-two-machine-onboarding-evidence.mjs",
    "test:compose": "node scripts/test/run-with-temp-root.mjs -- node scripts/verify-compose-config.mjs",
    "test:e2e": "node scripts/test/run-with-temp-root.mjs -- npm run test:e2e:inner",
    "test:e2e:inner": "tsx --test tests/e2e/**/*.test.ts",
    "test:e2e:live": "CONVENE_WIRE_LIVE_RUNTIME_E2E=1 PI_TELEMETRY=0 node scripts/test/run-with-temp-root.mjs -- tsx --test tests/e2e/adaptive-discussion-live.test.ts",
    "validate": "npm run validate --workspaces --if-present",
    "lint:docs": "markdownlint-cli2 \"**/*.md\"",
    "bench:discussion": "CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 1260000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "test:discussion-benchmark": "node scripts/test/run-with-temp-root.mjs -- npm run test:discussion-benchmark:inner",
    "test:discussion-benchmark:inner": "node --test scripts/bench/codex-answer.test.mjs && tsx --test scripts/bench/discussion-review-packet.test.ts scripts/bench/discussion-answer.test.ts scripts/bench/discussion-continuation.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=legacy tsx --test scripts/bench/discussion-benchmark.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=review tsx --test scripts/bench/discussion-benchmark.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=continuation tsx --test scripts/bench/discussion-benchmark.test.ts && npm run test:discussion-workspace:inner && npm run test:discussion-complex:inner",
    "bench:discussion-review": "CONVENE_WIRE_BENCH_SUITE=review CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 1260000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "bench:discussion-continuation": "CONVENE_WIRE_BENCH_SUITE=continuation CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 1260000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "bench:discussion-workspace": "CONVENE_WIRE_BENCH_SUITE=workspace CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 1260000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "test:discussion-workspace": "node scripts/test/run-with-temp-root.mjs -- npm run test:discussion-workspace:inner",
    "test:discussion-workspace:inner": "node --test scripts/bench/workspace-evidence.test.mjs && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=workspace tsx --test scripts/bench/discussion-benchmark.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=workspace-remaining tsx --test scripts/bench/discussion-benchmark.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=workspace-delivery tsx --test scripts/bench/discussion-benchmark.test.ts",
    "test:discussion-codex-bootstrap": "node scripts/test/run-with-temp-root.mjs --timeout-ms 150000 -- node --test scripts/bench/codex-evidence-bootstrap.test.mjs",
    "bench:discussion-workspace-remaining": "CONVENE_WIRE_BENCH_SUITE=workspace-remaining CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 1260000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "bench:discussion-workspace-delivery": "CONVENE_WIRE_BENCH_SUITE=workspace-delivery CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 1260000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "bench:discussion-complex": "CONVENE_WIRE_BENCH_SUITE=complex CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 2160000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "test:discussion-complex": "node scripts/test/run-with-temp-root.mjs -- npm run test:discussion-complex:inner",
    "test:discussion-complex:inner": "node --test scripts/bench/complex-evidence.test.mjs && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=complex tsx --test scripts/bench/discussion-benchmark.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=complex-remaining tsx --test scripts/bench/discussion-benchmark.test.ts && CONVENE_WIRE_BENCH_SYNTHETIC=1 CONVENE_WIRE_BENCH_SUITE=complex-remaining CONVENE_WIRE_BENCH_SYNTHETIC_FAIL_FIRST=1 tsx --test scripts/bench/discussion-benchmark.test.ts",
    "bench:discussion-complex-remaining": "CONVENE_WIRE_BENCH_SUITE=complex-remaining CONVENE_WIRE_BENCH_LIVE=1 node scripts/test/run-with-temp-root.mjs --timeout-ms 2160000 -- tsx --test scripts/bench/discussion-benchmark.test.ts",
    "test:discussion-evidence-access": "node scripts/test/run-with-temp-root.mjs --timeout-ms 180000 -- tsx --test scripts/bench/evidence-access.test.ts scripts/bench/evidence-invocation-observer.test.mjs scripts/bench/evidence-visibility.test.ts scripts/bench/evidence-access-report.test.mjs",
    "bench:discussion-evidence-access": "node scripts/test/run-with-temp-root.mjs --timeout-ms 2850000 -- tsx scripts/bench/evidence-access-execute.ts --execute-qa072-frozen-nine",
    "test:discussion-evidence-screening": "node scripts/test/run-with-temp-root.mjs --timeout-ms 180000 -- tsx --test scripts/bench/evidence-screening.test.ts",
    "bench:discussion-evidence-screening": "node scripts/test/run-with-temp-root.mjs --timeout-ms 2850000 -- tsx scripts/bench/evidence-screening.ts --execute-qa074-frozen-nine",
    "test:discussion-claim-adjudication": "node scripts/test/run-with-temp-root.mjs --timeout-ms 180000 -- tsx --test scripts/bench/claim-adjudication.test.ts scripts/bench/claim-adjudication-report.test.ts",
    "bench:discussion-claim-adjudication": "node scripts/test/run-with-temp-root.mjs --timeout-ms 1950000 -- tsx scripts/bench/claim-adjudication.ts --execute-qa075-frozen-six"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "ws": "8.21.3"
  }
}
