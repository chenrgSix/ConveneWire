{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentroom.dev/schemas/local-node/control.schema.json",
  "title": "Local Node private control protocol",
  "oneOf": [
    {
      "$ref": "#/$defs/LocalNodeIdentity"
    },
    {
      "$ref": "#/$defs/LocalNodeLaunch"
    },
    {
      "$ref": "#/$defs/LocalNodeReady"
    },
    {
      "$ref": "#/$defs/LocalNodeBinding"
    },
    {
      "$ref": "#/$defs/LocalNodeControlState"
    },
    {
      "$ref": "#/$defs/DesktopHandoffRequest"
    },
    {
      "$ref": "#/$defs/DesktopHandoffScope"
    }
  ],
  "$defs": {
    "LocalNodeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "nodeId",
        "ownerUserId",
        "port",
        "secret"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^node_[A-Za-z0-9_-]{8,128}$"
        },
        "ownerUserId": {
          "type": "string",
          "pattern": "^user_[A-Za-z0-9_-]{8,128}$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "secret": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "LocalNodeLaunch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "identity",
        "controlToken"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/LocalNodeIdentity"
        },
        "controlToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "LocalNodeReady": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "nodeId",
        "origin",
        "launchProof"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^node_[A-Za-z0-9_-]{8,128}$"
        },
        "origin": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$"
        },
        "launchProof": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "LocalNodeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverUrl",
        "deviceId",
        "teamId",
        "ownerMemberId",
        "token"
      ],
      "properties": {
        "serverUrl": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]{1,5}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^device_[A-Za-z0-9_-]{8,128}$"
        },
        "teamId": {
          "type": "string",
          "pattern": "^team_[A-Za-z0-9_-]{8,128}$"
        },
        "ownerMemberId": {
          "type": "string",
          "pattern": "^member_[A-Za-z0-9_-]{8,128}$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "LocalNodeControlState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "consoleRequestId"
      ],
      "properties": {
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalNodeBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "consoleRequestId": {
          "type": "string",
          "maxLength": 43,
          "pattern": "^([A-Za-z0-9_-]{43})?$"
        },
        "handoffTaskId": {
          "type": "string",
          "maxLength": 134
        }
      }
    },
    "DesktopHandoffRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "taskId"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "scope",
            "confirm",
            "validate",
            "release"
          ]
        },
        "taskId": {
          "type": "string",
          "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
        },
        "adoptionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "audienceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runId": {
          "type": "string",
          "pattern": "^run_[A-Za-z0-9_-]{8,128}$"
        }
      }
    },
    "DesktopHandoffScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "teamId",
        "roomId",
        "taskId",
        "agentId",
        "deviceId",
        "ownerMemberId",
        "audienceDigest",
        "audience",
        "taskTitle",
        "roomName",
        "agentName",
        "state",
        "adoptionId"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^node_[A-Za-z0-9_-]{8,128}$"
        },
        "teamId": {
          "type": "string",
          "pattern": "^team_[A-Za-z0-9_-]{8,128}$"
        },
        "roomId": {
          "type": "string",
          "pattern": "^room_[A-Za-z0-9_-]{8,128}$"
        },
        "taskId": {
          "type": "string",
          "pattern": "^task_[A-Za-z0-9_-]{8,128}$"
        },
        "agentId": {
          "type": "string",
          "pattern": "^agent_[A-Za-z0-9_-]{8,128}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^device_[A-Za-z0-9_-]{8,128}$"
        },
        "ownerMemberId": {
          "type": "string",
          "pattern": "^member_[A-Za-z0-9_-]{8,128}$"
        },
        "audienceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audience": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "taskTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "roomName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "agentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "type": "string",
          "enum": [
            "available",
            "attached",
            "released",
            "paused"
          ]
        },
        "adoptionId": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
